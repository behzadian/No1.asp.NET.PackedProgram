{
	"DevelopmentConfig": {
		"PrintDetailsPublicly": false,
		"WriteIndented": false
	},
	"Serilog": {
		"Using": [
			"Serilog.Sinks.Console"
		],
		"MinimumLevel": {
			"Default": "Information",
			"Override": {
				"Microsoft": "Warning",
				"Microsoft.AspNetCore": "Warning",
				"Microsoft.EntityFrameworkCore": "Warning",
				"System": "Warning"
			}
		},
		"WriteTo": [
			{
				"Name": "Console"
			}
		],
		"Properties": {}
	},
	"AllowedHosts": "*",
	"HealthConfig": {
		"Enabled": true,
		"RequiredHosts": [],
		"SecurityExpression": "AllowAll"
	},
	"SwaggerConfig": {
		"AllowedCIDRs": ["0.0.0.0/0"]
	}
}